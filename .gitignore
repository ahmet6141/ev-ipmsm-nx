# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.conda/

# Siemens NX / generated CAD build outputs (regenerate via batch_build.py / NX)
# keep the folder's README so the layout stays self-documenting
build/*
!build/README.md
*.prt
*.prt.*
*.stp
*.step
*.x_t
*.xmt_txt
*.jt
*.fem
*.sim

# run / smoke logs
*.log

# archived experimental / scratch files (kept on disk, not version-controlled)
/archive/*
!/archive/README.md

# root-level generated artifacts (regenerate via `python -m motor_nx.cli ...`)
/blueprint.json
/preview.svg

# throwaway NX journals (leading underscore = temporary, run via Play Journal)
/_*.py

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# generated 2D drawing output (regenerate via cli drawings)
/drawings/

# generated manufacturing package (regenerate via cli package)
/manufacturing/

# NX scene-inspector outputs (regenerated by verification/nx_inspect.py)
*_inspect.json
verification/nx_inspect_report.json
